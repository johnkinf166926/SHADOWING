# Local Prisma / SQLite database. Keep the real .env file private.
DATABASE_URL="file:../data/shadowing-coach.db"

# Optional future speech evaluation integration. Never expose this in client code.
SPEECH_EVALUATION_PROVIDER="manual"
SPEECH_SERVICE_ENDPOINT=""
SPEECH_SERVICE_API_KEY=""

# Local upload limits
MAX_AUDIO_UPLOAD_MB="80"
