{
  "name": "shadowing-coach-japanese",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:d1:generate": "drizzle-kit generate",
    "content:validate": "tsx scripts/validate-content.ts",
    "content:import": "tsx scripts/import-content.ts",
    "content:export": "tsx scripts/export-content.ts",
    "book:render": "node scripts/render-book-pages.mjs",
    "book:ocr": "node scripts/ocr-book-pages.mjs",
    "book:contact": "node scripts/create-book-contact-sheets.mjs",
    "book:crop": "node scripts/crop-book-pages.mjs",
    "book:ocr:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/ocr-book-pages-windows.ps1",
    "book:build-content": "node scripts/build-book-content.mjs",
    "book:analyze-audio": "node scripts/analyze-master-audio.mjs",
    "book:split-audio": "node scripts/split-master-audio.mjs",
    "book:attach-audio": "node scripts/attach-track-audio.mjs",
    "book:align-srt": "node scripts/align-srt-lines.mjs",
    "book:align-srt:new": "node scripts/align-srt-lines.mjs --srt private_content/audio/book-full-new.srt --fallback-srt private_content/audio/book-full.srt --output private_content/audio/srt-line-timings-new-hybrid.json",
    "book:validate-content": "tsx scripts/validate-book-content.ts",
    "book:import-local": "node scripts/import-runtime-content.mjs",
    "book:sync-units": "node scripts/sync-book-unit-metadata.mjs",
    "course:export-bundle": "node scripts/export-bundled-course.mjs",
    "smoke:local": "node scripts/smoke-local.mjs",
    "sample-audio": "node scripts/generate-sample-audio.mjs",
    "icons": "node scripts/generate-icons.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.4.0",
    "@prisma/client": "^6.19.1",
    "drizzle-orm": "0.45.2",
    "lucide-react": "^1.26.0",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-hook-form": "^7.82.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "^4.20260702.1",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "4.2.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "eslint-config-prettier": "^10.1.8",
    "ffmpeg-static": "^5.3.0",
    "jsdom": "^29.1.1",
    "pdfjs-dist": "^6.1.200",
    "prettier": "^3.9.6",
    "prisma": "^6.19.1",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "tesseract.js": "^7.0.0",
    "tsx": "^4.23.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "vitest": "^4.1.10",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
